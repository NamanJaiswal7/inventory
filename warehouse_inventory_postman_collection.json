          ]
        },
        "description": "Tests centralized GlobalExceptionHandler: returns 400 Bad Request with supported types."
      },
      "response": []
    },
    {
      "name": "5. Naive - Receive 20 Electronics (Memory Bloat)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/naive/receive?type=electronics&count=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "naive",
            "receive"
          ],
          "query": [
            {
              "key": "type",
              "value": "electronics"
            },
            {
              "key": "count",
              "value": "20"
            }
          ]
        },
        "description": "Demonstrates memory problem: 20 boxes allocate 20 separate 5MB byte buffers (~120 MB RAM)."
      },
      "response": []
    },
    {
      "name": "6. Naive - Receive 1,000 Electronics (OutOfMemory Demonstration)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/naive/receive?type=electronics&count=1000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "naive",
            "receive"
          ],
          "query": [
            {
              "key": "type",
              "value": "electronics"
            },
            {
              "key": "count",
              "value": "1000"
            }
          ]
        },
        "description": "Demonstrates heap exhaustion: attempting to allocate 5GB causes OutOfMemoryError, gracefully caught with telemetry."
      },
      "response": []
    }
  ]
