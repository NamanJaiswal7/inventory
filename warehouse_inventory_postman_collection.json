{
  "info": {
    "_postman_id": "c1f7b8e2-8921-4d3e-953b-e3a1f4b23456",
    "name": "Warehouse Inventory API (Flyweight & Factory Method)",
    "description": "Postman test collection for testing the Naive vs. Optimized E-Commerce Warehouse Inventory implementations demonstrating Flyweight and Factory Method design patterns.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Optimized - Receive 1,000 Electronics (Flyweight + Factory)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/optimized/receive?type=electronics&count=1000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "optimized",
            "receive"
          ],
          "query": [
            {
              "key": "type",
              "value": "electronics",
              "description": "Product category: electronics | books | clothing"
            },
            {
              "key": "count",
              "value": "1000",
              "description": "Number of physical boxes arriving"
            }
          ]
        },
        "description": "Demonstrates the Flyweight Pattern: 1,000 physical items share a single 5MB ProductCatalogItem in heap memory. Retained memory is only ~6.14 MB."
      },
      "response": []
    },
    {
      "name": "2. Optimized - Receive 500 Books (Factory Method)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/optimized/receive?type=books&count=500",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "optimized",
            "receive"
          ],
          "query": [
            {
              "key": "type",
              "value": "books"
            },
            {
              "key": "count",
              "value": "500"
            }
          ]
        },
        "description": "Demonstrates Factory Method polymorphic dispatch: delegates to BooksReceiver without switch statements."
      },
      "response": []
    },
    {
      "name": "3. Optimized - Receive 250 Clothing (Factory Method)",
      "request": {
