            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/optimized/receive?type=clothing&count=250",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "optimized",
            "receive"
          ],
          "query": [
            {
              "key": "type",
              "value": "clothing"
            },
            {
